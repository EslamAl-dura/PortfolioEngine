@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="flex min-h-[80vh] items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-md space-y-8">

        <!-- Header / Icon -->
        <div class="text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-600/10 border border-emerald-500/20 text-emerald-400">
                <i class="bi bi-envelope-check-fill text-3xl"></i>
            </div>
            <h2 class="mt-4 text-3xl font-bold tracking-tight text-slate-100">Check your email</h2>
            <p class="mt-2 text-sm text-slate-400">We've sent password reset instructions to your inbox.</p>
        </div>

        <!-- Info Card Container -->
        <div class="rounded-2xl border border-slate-800 bg-slate-900 p-8 shadow-2xl backdrop-blur-sm text-center">
            <p class="text-sm text-slate-300 leading-relaxed">
                If an account exists with that email address, you will receive an email with a link to reset your password shortly.
            </p>

            <div class="mt-6 rounded-lg bg-slate-950/60 p-4 border border-slate-800 text-xs text-slate-400">
                <p>Didn't receive an email? Be sure to check your spam folder or try requesting a new link.</p>
            </div>

            <!-- Back to Login Navigation -->
            <div class="mt-8 flex justify-center border-t border-slate-800/80 pt-6 text-xs text-slate-400">
                <a asp-page="./Login" class="inline-flex items-center gap-2 font-medium text-indigo-400 hover:text-indigo-300 hover:underline">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back to Log in</span>
                </a>
            </div>
        </div>
    </div>
</div>