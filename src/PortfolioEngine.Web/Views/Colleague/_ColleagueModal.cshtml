<div id="colleagueModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
    <div id="colleagueModalContainer" class="modal-scrollbar bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl w-full max-w-lg max-h-full flex flex-col transform scale-95 transition-transform duration-200 overflow-hidden">

        <!-- Header -->
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between shrink-0">
            <h3 id="colleagueModalTitle" class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i id="colleagueModalIcon" class="bi bi-people text-blue-600"></i>
                <span id="colleagueModalTitleText">Add Colleague</span>
            </h3>
            <button type="button" onclick="closeColleagueModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                <i class="bi bi-x-lg text-lg"></i>
            </button>
        </div>

        <!-- Form Wrapper -->
        <form id="colleagueForm" method="post" enctype="multipart/form-data" class="flex flex-col min-h-0 flex-1">
            @Html.AntiForgeryToken()

            <!-- Hidden field for Colleague ID -->
            <input type="hidden" id="colleague_Id" name="Id" value="" />

            <!-- Scrollable Body -->
            <div class="p-6 space-y-4 overflow-y-auto flex-1 custom-scrollbar">

                <!-- Validation Summary -->
                <div id="colleagueValidationSummary" class="hidden p-3 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 rounded-lg text-xs text-red-600 dark:text-red-400"></div>

                <!-- Name -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Name <span class="text-rose-500">*</span></label>
                    <input id="colleague_Name" name="Name" required placeholder="e.g. Jane Doe"
                           class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                </div>

                <!-- Role -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Role / Designation <span class="text-rose-500">*</span></label>
                    <input id="colleague_Role" name="Role" required placeholder="e.g. Senior Frontend Developer"
                           class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                </div>

                <!-- Profile Url -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Profile / LinkedIn URL</label>
                    <input id="colleague_ProfileUrl" name="ProfileUrl" type="url" placeholder="e.g. https://linkedin.com/in/username"
                           class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                </div>

                <!-- Start Date -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Start Date <span class="text-rose-500">*</span></label>
                    <input id="colleague_StartDate" name="StartDate" type="date" required
                           class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                </div>

                <!-- Until Now Checkbox -->
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="colleague_UntilNow" name="UntilNow" value="true"
                           class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800" />
                    <input type="hidden" name="UntilNow" value="false" />
                    <label for="colleague_UntilNow" class="text-sm font-medium text-slate-700 dark:text-slate-300 cursor-pointer">
                        Currently working together
                    </label>
                </div>

                <!-- End Date -->
                <div id="endDateContainer">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">End Date</label>
                    <input id="colleague_EndDate" name="EndDate" type="date"
                           class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                </div>

                <!-- Avatar File Upload -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Avatar Image</label>
                    <div class="flex items-center gap-4">
                        <!-- Preview Circle -->
                        <div class="w-12 h-12 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-400 overflow-hidden shrink-0">
                            <img id="avatarPreview" src="" class="w-full h-full object-cover hidden" />
                            <i id="avatarPlaceholderIcon" class="bi bi-person text-2xl"></i>
                        </div>
                        <div class="flex-1">
                            <input id="colleague_AvatarFile" name="AvatarFile" type="file" accept="image/*"
                                   class="block w-full text-xs text-slate-500 dark:text-slate-400
                                          file:mr-4 file:py-2 file:px-4
                                          file:rounded-xl file:border-0
                                          file:text-xs file:font-semibold
                                          file:bg-blue-50 file:text-blue-700
                                          hover:file:bg-blue-100
                                          dark:file:bg-slate-800 dark:file:text-slate-300" />
                            <p class="mt-1 text-[10px] text-slate-500 dark:text-slate-400">Supported formats: JPG, PNG, WEBP, SVG</p>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Footer -->
            <div class="px-6 py-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 flex justify-end gap-3 shrink-0">
                <button type="button" onclick="closeColleagueModal()"
                        class="px-5 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-700 rounded-xl transition-all">
                    Cancel
                </button>
                <button type="submit" id="colleagueSubmitBtn"
                        class="px-5 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-all">
                    Create Colleague
                </button>
            </div>
        </form>
    </div>
</div>
