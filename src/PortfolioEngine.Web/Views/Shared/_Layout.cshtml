<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100 antialiased">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PortfolioEngine</title>

    <!-- Favicon for the site-->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Bootstrap Icons (Icons reference) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Compiled Tailwind CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/v/dt/moment-2.29.4/jszip-3.10.1/dt-3.0.1/af-3.0.0/b-4.0.1/cr-3.0.0/cc-2.0.0/date-2.0.0/fc-6.0.0/fh-5.0.0/kt-3.0.0/r-4.0.1/rg-2.0.0/rr-2.0.0/sc-3.0.0/sb-2.0.0/sl-4.0.0/datatables.min.css" rel="stylesheet" integrity="sha384-L2BTKoJIlqUTWOLeWTo0I89RIz/Nx/NfpcCdKklve5jkhP63qJ0J6jhh8ilM3Gra" crossorigin="anonymous">


</head>
<body class="flex min-h-full flex-col font-serif font-bold">

    <!-- Mobile Top Header Bar (Visible on screens smaller than lg) -->
    <header class="sticky top-0 z-40 flex items-center justify-between border-b border-slate-800 bg-slate-900/90 px-4 py-3 backdrop-blur-md lg:hidden">
        <a class="flex items-center gap-2 text-lg font-bold tracking-tight text-indigo-400" asp-controller="Home" asp-action="Index">
            <i class="bi bi-cpu text-xl text-indigo-500"></i>
            <span class="">PortfolioEngine</span>
        </a>
        <button id="mobile-menu-toggle" type="button" class="rounded-lg p-2 text-slate-400 hover:bg-slate-800 hover:text-slate-100 focus:outline-none">
            <i class="bi bi-list text-2xl"></i>
        </button>
    </header>

    <div class="flex flex-1">
        <!-- Sidebar Navigation (Fixed on Desktop `lg:flex`, Drawer overlay on Mobile) -->
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 hidden w-64 flex-col border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 transition-colors duration-200 lg:flex">

    <!-- Sidebar Header Brand -->
    <div class="flex h-16 items-center justify-between border-b border-slate-200/80 dark:border-slate-800/80 px-6">
        <a class="flex items-center gap-2.5 text-lg font-bold tracking-tight text-indigo-600 dark:text-indigo-400" asp-controller="Home" asp-action="Index">
            <i class="bi bi-cpu text-2xl text-indigo-600 dark:text-indigo-500"></i>
            <span>PortfolioEngine</span>
        </a>
        <button id="mobile-menu-close" type="button" class="rounded-lg p-1 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 lg:hidden">
            <i class="bi bi-x-lg text-lg"></i>
        </button>
    </div>

    <!-- Navigation Links -->
    <nav class="flex-1 space-y-1.5 px-4 py-6">
        <a asp-controller="Home" asp-action="Index"
           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-all text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400">
            <i class="bi bi-speedometer2 text-lg"></i>
            <span>Dashboard</span>
        </a>

        <a asp-controller="TechCategory" asp-action="Index"
           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-all text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400">
            <i class="bi bi-bookmarks text-lg"></i>
            <span>Categories</span>
        </a>

        <a asp-controller="Technology" asp-action="Index"
           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-all text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400">
            <i class="bi bi-star text-lg"></i>
            <span>Technologies</span>
        </a>

        <a asp-controller="Skill" asp-action="Index"
           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-all text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400">
            <i class="bi bi-award text-lg"></i>
            <span>Skills</span>
        </a>

        <a asp-controller="Colleague" asp-action="Index"
           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-all text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400">
            <i class="bi bi-people text-lg"></i>
            <span>Colleagues</span>
        </a>

        <a asp-controller="Project" asp-action="Index"
           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-all text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400">
            <i class="bi bi-grid text-lg"></i>
            <span>Projects</span>
        </a>

        <a asp-controller="Contact" asp-action="Index"
           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-all text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400">
            <i class="bi bi-person-vcard text-lg"></i>
            <span>Contacts</span>
        </a>

        <a asp-controller="Message" asp-action="Index"
           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-all text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400">
            <i class="bi bi-envelope-arrow-down text-lg"></i>
            <span>Messages</span>
        </a>

        <a href="/scalar/v1" target="_blank"
           class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-all text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-indigo-600 dark:hover:text-indigo-400">
            <i class="bi bi-code-square text-lg"></i>
            <span>Scalar API Docs</span>
            <i class="bi bi-box-arrow-up-right ml-auto text-xs text-slate-400 dark:text-slate-500"></i>
        </a>
    </nav>

    <!-- User Auth Profile Section at Sidebar Bottom -->
    <div class="border-t border-slate-200 dark:border-slate-800 p-4 bg-slate-50/50 dark:bg-slate-900/50">
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 overflow-hidden">
                    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-600 font-semibold text-white shadow-sm">
                        @(User.Identity.Name?[0].ToString().ToUpper() ?? "A")
                    </div>
                    <div class="truncate">
                        <p class="truncate text-xs font-semibold text-slate-900 dark:text-slate-200">@User.Identity.Name</p>
                        <span class="text-[10px] font-medium text-emerald-600 dark:text-emerald-400">● Admin</span>
                    </div>
                </div>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 hover:text-rose-600 dark:hover:text-rose-400 transition-colors" title="Log out">
                        <i class="bi bi-box-arrow-right text-lg"></i>
                    </button>
                </form>
            </div>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-500 transition-colors">
                <i class="bi bi-box-arrow-in-right"></i>
                <span>Log In</span>
            </a>
        }
    </div>
</aside>

        <!-- Main Workspace Area -->
        <div class="flex flex-1 flex-col lg:pl-64 bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen transition-colors duration-200">
            <main role="main" class="flex-1 p-6 lg:p-10">
                <!-- TempData Success Toast Banner -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div id="alert-banner" class="mb-6 flex items-center justify-between rounded-xl border border-emerald-200 dark:border-emerald-500/30 bg-emerald-50 dark:bg-emerald-950/40 p-4 text-emerald-800 dark:text-emerald-300 shadow-sm dark:shadow-lg backdrop-blur-sm transition-all">
                        <div class="flex items-center gap-3">
                            <i class="bi bi-check-circle-fill text-xl text-emerald-600 dark:text-emerald-400"></i>
                            <span class="text-sm font-medium">@TempData["SuccessMessage"]</span>
                        </div>
                        <button type="button" onclick="document.getElementById('alert-banner').remove()" class="text-emerald-600 dark:text-emerald-400 hover:text-emerald-800 dark:hover:text-emerald-200 p-1 rounded-lg">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Sticky Bottom Footer -->
            <footer class="mt-auto border-t border-slate-200 dark:border-slate-900 bg-white/80 dark:bg-slate-950/80 px-6 py-4 text-xs text-slate-500 dark:text-slate-400 backdrop-blur-sm transition-colors duration-200">
                <div class="flex flex-col items-center justify-between gap-2 sm:flex-row">
                    <span>&copy; @DateTime.Now.Year PortfolioEngine Web Admin</span>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Privacy Policy</a>
                </div>
            </footer>
        </div>
    </div>

    <!-- Mobile Drawer Overlay Backdrop -->
    <div id="sidebar-backdrop" class="fixed inset-0 z-40 hidden bg-slate-950/80 backdrop-blur-sm lg:hidden"></div>

    <!-- jQuery with CDN and Built-in ASP.NET Core Local Fallback -->
   <script src="https://code.jquery.com/jquery-3.7.1.min.js"
        asp-fallback-src="~/lib/jquery/dist/jquery.min.js"
        asp-fallback-test="window.jQuery"
        crossorigin="anonymous"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="></script>

    <!-- Interactive Sidebar Toggle Script -->
    <script>
            document.addEventListener("DOMContentLoaded", () => {
                const sidebar = document.getElementById("sidebar");
                const backdrop = document.getElementById("sidebar-backdrop");
                const toggleBtn = document.getElementById("mobile-menu-toggle");
                const closeBtn = document.getElementById("mobile-menu-close");

                function openMenu() {
                    sidebar.classList.remove("hidden");
                    backdrop.classList.remove("hidden");
                }

                function closeMenu() {
                    sidebar.classList.add("hidden");
                    backdrop.classList.add("hidden");
                }

                toggleBtn?.addEventListener("click", openMenu);
                closeBtn?.addEventListener("click", closeMenu);
                backdrop?.addEventListener("click", closeMenu);
            });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" integrity="sha384-VFQrHzqBh5qiJIU0uGU5CIW3+OWpdGGJM9LBnGbuIH2mkICcFZ7lPd/AAtI7SNf7" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" integrity="sha384-/RlQG9uf0M2vcTw3CX7fbqgbj/h8wKxw7C3zu9/GxcBPRKOEcESxaxufwRXqzq6n" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/v/dt/moment-2.29.4/jszip-3.10.1/dt-3.0.1/af-3.0.0/b-4.0.1/cr-3.0.0/cc-2.0.0/date-2.0.0/fc-6.0.0/fh-5.0.0/kt-3.0.0/r-4.0.1/rg-2.0.0/rr-2.0.0/sc-3.0.0/sb-2.0.0/sl-4.0.0/datatables.min.js" integrity="sha384-4vN1rVLwCZAyaPoKd6P1XiFv1cyCK+L6NozXYHAUpu75erzN6cj7NfneXM2fTPUp" crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>