<div id="deleteTechModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
    <div id="deleteTechModalContainer" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform duration-200">
        <form id="deleteTechForm" method="post" class="p-6 text-center space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="delete_TechId" name="Id" />

            <div class="mx-auto w-12 h-12 flex items-center justify-center rounded-full bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400">
                <i class="bi bi-exclamation-triangle text-2xl"></i>
            </div>

            <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">Delete Technology?</h3>
                <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                    Are you sure you want to delete <strong id="delete_TechName" class="text-slate-800 dark:text-slate-200"></strong>? This action cannot be undone.
                </p>
            </div>

            <div class="pt-2 flex items-center justify-center gap-3">
                <button type="button" onclick="closeDeleteTechModal()" class="w-1/2 py-2.5 text-sm font-medium text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 rounded-xl">Cancel</button>
                <button type="submit" class="w-1/2 py-2.5 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-sm">Delete</button>
            </div>
        </form>
    </div>
</div>