@using System.Text.Encodings.Web
@using System.Text.Json
@model IEnumerable<PortfolioEngine.Application.DTOs.TechnologyDto>

@{
    ViewData["Title"] = "Technologies Management";
    var groupedTechnologies = Model.GroupBy(t => t.TechCategoryName);
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Top Header Bar -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl flex items-center gap-3">
                <i class="bi bi-cpu text-blue-600"></i> Technology Stack
            </h1>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
                Managing <span class="font-semibold text-slate-900 dark:text-slate-200">@Model.Count()</span> technologies across
                <span class="font-semibold text-slate-900 dark:text-slate-200">@groupedTechnologies.Count()</span> categories.
            </p>
        </div>

        <div>
            <button type="button"
                    onclick="openCreateTechModal()"
                    class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-all">
                <i class="bi bi-plus-lg"></i>
                <span>Add Technology</span>
            </button>
        </div>
    </div>

    <!-- Empty State -->
    @if (!Model.Any())
    {
        <div class="text-center py-16 px-6 bg-slate-50 dark:bg-slate-900/50 rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-800">
            <div class="mx-auto w-12 h-12 flex items-center justify-center rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 mb-4">
                <i class="bi bi-cpu text-2xl"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">No Technologies Found</h3>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400 max-w-sm mx-auto">
                Get started by adding your first technology skill or framework.
            </p>
            <div class="mt-6">
                <button type="button"
                        onclick="openCreateTechModal()"
                        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-all">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add Technology</span>
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Technologies Grouped Sections -->
        <div class="space-y-10">
            @foreach (var group in groupedTechnologies)
            {
                <div class="space-y-4">
                    <!-- Category Header -->
                    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-3">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                            <h2 class="text-sm font-bold text-slate-800 dark:text-slate-200 tracking-wider uppercase">
                                @group.Key
                            </h2>
                            <span class="ml-2 px-2.5 py-0.5 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                @group.Count()
                            </span>
                        </div>

                        @if (group.FirstOrDefault() != null)
                        {
                            <button type="button"
                                    onclick="openCreateTechModal('@group.First().TechCategoryId')"
                                    class="text-xs text-blue-600 dark:text-blue-400 hover:underline font-medium flex items-center gap-1 transition-colors">
                                <i class="bi bi-plus-lg"></i> Add to @group.Key
                            </button>
                        }
                    </div>

                    <!-- Cards Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                        @foreach (var tech in group)
                        {
                            <div class="group relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-200 flex flex-col justify-between">

                                <div>
                                    <!-- Header: Icon & Action Buttons -->
                                    <div class="flex items-start justify-between gap-3 mb-3">
                                        <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-900/30 border border-blue-100 dark:border-blue-800 flex items-center justify-center text-blue-600 dark:text-blue-400 text-lg">
                                            @if (!string.IsNullOrWhiteSpace(tech.IconClass))
                                            {
                                                <i class="bi bi-@tech.IconClass"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-code-slash"></i>
                                            }
                                        </div>

                                        <!-- Quick Actions -->
                                        <div class="flex items-center gap-1">
                                            <button type="button"
                                                    data-id="@tech.Id"
                                                    data-name="@tech.Name"
                                                    data-categoryid="@tech.TechCategoryId"
                                                    data-icon="@tech.IconClass"
                                                    data-description="@tech.Description"
                                                    onclick="openEditTechModalFromBtn(this)"
                                                    class="px-2.5 py-1 text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors">
                                                <i class="bi bi-pencil mr-1"></i>
                                            </button>

                                            <button type="button"
                                                    onclick="openDeleteTechModal('@tech.Id', '@JavaScriptEncoder.Default.Encode(tech.Name)')"
                                                    class="p-1 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 rounded-lg transition-colors">
                                                <i class="bi bi-trash text-xs"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Details -->
                                    <h3 class="font-bold text-base text-slate-900 dark:text-white mb-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                                        @tech.Name
                                    </h3>
                                    <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-3 leading-relaxed">
                                        @tech.Description
                                    </p>
                                </div>

                                <!-- Footer Tag -->
                                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 dark:text-slate-500">
                                    <span class="truncate">Category: @tech.TechCategoryName</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Unified Partials -->
<partial name="_TechModal" />
<partial name="_DeleteTechModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="../Views//Technology/Index.cshtml.js" asp-append-version="true"></script>
}