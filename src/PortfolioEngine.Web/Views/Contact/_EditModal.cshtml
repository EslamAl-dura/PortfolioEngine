@model ContactViewModel

<!-- Modal Header -->
<div class="flex items-center justify-between border-b border-gray-200 pb-4 dark:border-gray-700">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
        Edit Contact
    </h3>
    <button type="button"
            onclick="closeModal()"
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-transparent text-sm text-gray-400 hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-700 dark:hover:text-white transition-colors">
        <i class="bi bi-x-lg text-lg"></i>
        <span class="sr-only">Close modal</span>
    </button>
</div>

<!-- Modal Form -->
<form action="@Url.Action("Edit", "Contact")" method="post" onsubmit="return submitForm(this)" class="mt-4 space-y-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <!-- Name -->
    <div>
        <label asp-for="Name" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"></label>
        <input asp-for="Name"
               class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-blue-500 dark:focus:ring-blue-500" />
        <span asp-validation-for="Name" class="mt-1 block text-xs font-medium text-red-600 dark:text-red-400"></span>
    </div>

    <!-- Value -->
    <div>
        <label asp-for="Value" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"></label>
        <input asp-for="Value"
               class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-blue-500 dark:focus:ring-blue-500" />
        <span asp-validation-for="Value" class="mt-1 block text-xs font-medium text-red-600 dark:text-red-400"></span>
    </div>

    <!-- Contact Type -->
    <div>
        <label asp-for="ContactType" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"></label>
        <select asp-for="ContactType"
                asp-items="ViewBag.ContactTypes"
                class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:focus:border-blue-500 dark:focus:ring-blue-500"></select>
        <span asp-validation-for="ContactType" class="mt-1 block text-xs font-medium text-red-600 dark:text-red-400"></span>
    </div>

    <!-- Icon Class -->
    <div>
        <label asp-for="IconClass" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"></label>
        <input asp-for="IconClass"
               class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-blue-500 dark:focus:ring-blue-500" />
        <span asp-validation-for="IconClass" class="mt-1 block text-xs font-medium text-red-600 dark:text-red-400"></span>
    </div>

    <!-- Description -->
    <div>
        <label asp-for="Description" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"></label>
        <textarea asp-for="Description"
                  rows="2"
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500 dark:border-gray-600 dark:bg-gray-700 dark:text-white dark:placeholder-gray-400 dark:focus:border-blue-500 dark:focus:ring-blue-500"></textarea>
        <span asp-validation-for="Description" class="mt-1 block text-xs font-medium text-red-600 dark:text-red-400"></span>
    </div>

    <!-- Modal Footer / Actions -->
    <div class="flex items-center justify-end space-x-2 border-t border-gray-200 pt-4 dark:border-gray-700">
        <button type="button"
                onclick="closeModal()"
                class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white transition-colors">
            Cancel
        </button>
        <button type="submit"
                class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 transition-colors">
            Update Contact
        </button>
    </div>
</form>