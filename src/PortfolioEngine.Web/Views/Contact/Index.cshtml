@using PortfolioEngine.Application.DTOs
@model IEnumerable<ContactDto>

@{
    ViewData["Title"] = "Contacts Management";
}

@Html.AntiForgeryToken()
<div class="container mx-auto px-4 py-6">
    <!-- Header Section -->
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-white">Contact Channels</h2>
        <button type="button"
                class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg shadow-sm transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                onclick="openModal('@Url.Action("Create", "Contact")')">
            <i class="bi bi-plus-lg mr-2"></i> Add Contact
        </button>
    </div>

    <!-- Table Container Card -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 dark:bg-gray-700/50 border-b border-gray-200 dark:border-gray-700 text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold">
                        <th class="px-6 py-3.5">Icon</th>
                        <th class="px-6 py-3.5">Name</th>
                        <th class="px-6 py-3.5">Value</th>
                        <th class="px-6 py-3.5">Type</th>
                        <th class="px-6 py-3.5">Description</th>
                        <th class="px-6 py-3.5 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700 text-sm text-gray-700 dark:text-gray-300">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-gray-500 dark:text-gray-400">
                                No contact items found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-700/30 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <i class="@item.IconClass text-xl text-blue-600 dark:text-blue-400"></i>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap font-semibold text-gray-900 dark:text-white">
                                    @item.Name
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <code class="font-mono text-xs bg-gray-100 dark:bg-gray-900 text-pink-600 dark:text-pink-400 px-2 py-1 rounded border border-gray-200 dark:border-gray-700">@item.Value</code>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cyan-100 dark:bg-cyan-950 text-cyan-800 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800">
                                        @item.ContactType
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-gray-500 dark:text-gray-400 text-xs">
                                    @item.Description
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right space-x-2">
                                    <button class="px-3 py-1.5 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700 text-xs font-medium rounded-md transition-colors"
                                            onclick="openModal('@Url.Action("Edit", "Contact", new { id = item.Id })')">
                                        Edit
                                    </button>
                                    <button class="px-3 py-1.5 border border-red-200 dark:border-red-900/50 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 text-xs font-medium rounded-md transition-colors"
                                            onclick="deleteContact('@item.Id')">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Container Shell -->
<div id="contactModal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-gray-900/75 backdrop-blur-sm transition-opacity" aria-hidden="true">
    <div class="flex min-h-screen items-center justify-center p-4">
        <div class="w-full max-w-lg transform overflow-hidden rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-6 shadow-xl transition-all" id="modalContent"></div>
    </div>
</div>

@section Scripts {
    <script>
        // Move functions to global scope so inline onclick="..." handlers can reach them
        function openModal(url) {
            $.get(url, function (data) {
                $('#modalContent').html(data);
                $('#contactModal').removeClass('hidden'); // Show Tailwind Modal
            });
        }

        function closeModal() {
            $('#contactModal').addClass('hidden'); // Hide Tailwind Modal
            $('#modalContent').html('');
        }

        function submitForm(formElement) {
            $.ajax({
                url: $(formElement).attr('action'),
                type: 'POST',
                data: $(formElement).serialize(),
                success: function (response) {
                    if (response.success) {
                        closeModal();
                        location.reload();
                    } else {
                        alert(response.errors ? response.errors.join("\n") : response.message);
                    }
                }
            });
            return false;
        }

        function deleteContact(id) {
            if (!confirm('Are you sure you want to delete this contact?')) return;

            $.ajax({
                url: '/Contact/Delete/' + id,
                type: 'POST',
                headers: {
                    "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                }
            });
        }

        // Close modal when clicking on the backdrop
        $(document).ready(function () {
            $('#contactModal').on('click', function (e) {
                if (e.target === this) {
                    closeModal();
                }
            });
        });
    </script>
}