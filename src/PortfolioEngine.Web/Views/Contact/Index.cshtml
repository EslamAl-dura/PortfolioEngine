@using System.Text.Encodings.Web
@using PortfolioEngine.Application.DTOs
@model IEnumerable<ContactDto>

@{
    ViewData["Title"] = "Contacts Management";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Top Header Bar -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl flex items-center gap-3">
                <i class="bi bi-person-lines-fill text-blue-600"></i> Contact Channels
            </h1>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
                Manage your public contact mechanisms, social profiles, and reachability details.
            </p>
        </div>

        <div>
            <button type="button"
                    onclick="openCreateContactModal()"
                    class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm transition-all">
                <i class="bi bi-plus-lg"></i>
                <span>Add Contact</span>
            </button>
        </div>
    </div>

    <!-- Contact List Table Shell -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold">
                        <th class="px-6 py-4">Icon</th>
                        <th class="px-6 py-4">Name</th>
                        <th class="px-6 py-4">Value</th>
                        <th class="px-6 py-4">Type</th>
                        <th class="px-6 py-4">Description</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-sm text-slate-700 dark:text-slate-300">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-slate-500 dark:text-slate-400">
                                <div class="flex flex-col items-center justify-center">
                                    <i class="bi bi-inbox text-3xl mb-2 text-slate-400"></i>
                                    <span>No contact items found.</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="w-9 h-9 rounded-xl bg-blue-50 dark:bg-blue-900/30 border border-blue-100 dark:border-blue-800 flex items-center justify-center text-blue-600 dark:text-blue-400">
                                        <i class="bi bi-@(string.IsNullOrWhiteSpace(item.IconClass) ? "envelope-fill" : item.IconClass.Replace("bi bi-", "").Replace("bi-", ""))"></i>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap font-bold text-slate-900 dark:text-white">
                                    @item.Name
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <code class="font-mono text-xs bg-slate-100 dark:bg-slate-800 text-pink-600 dark:text-pink-400 px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-700">@item.Value</code>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-cyan-50 dark:bg-cyan-950/50 text-cyan-700 dark:text-cyan-300 border border-cyan-200 dark:border-cyan-800">
                                        @item.ContactType
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-slate-500 dark:text-slate-400 text-xs">
                                    @item.Description
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right space-x-1">
                                    <button type="button"
                                            data-id="@item.Id"
                                            data-name="@item.Name"
                                            data-value="@item.Value"
                                            data-type="@item.ContactType"
                                            data-icon="@item.IconClass"
                                            data-description="@item.Description"
                                            onclick="openEditContactModalFromBtn(this)"
                                            class="px-2.5 py-1 text-xs font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors">
                                        <i class="bi bi-pencil mr-1"></i>
                                    </button>

                                    <button type="button"
                                            onclick="openDeleteContactModal('@item.Id', '@JavaScriptEncoder.Default.Encode(item.Name)')"
                                            class="p-1 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 rounded-lg transition-colors">
                                        <i class="bi bi-trash text-xs"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Unified Modal Partials -->
<partial name="_ContactModal" />
<partial name="_DeleteContactModal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="../Views//Contact/Index.cshtml.js" asp-append-version="true"></script>
}