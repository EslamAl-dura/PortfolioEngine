@using PortfolioEngine.Application.DTOs
@using PortfolioEngine.Domain.Common
@model PagedResultDto<MessageDto>

@{
    ViewData["Title"] = "Contact Messages";
    var filter = ViewBag.Filter as MessageFilterDto ?? new MessageFilterDto();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-3">
                <i class="bi bi-envelope-arrow-down-fill text-blue-600"></i> Inbox Messages
            </h1>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                Manage incoming inquiries and contact messages.
            </p>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <form id="filterForm" method="get" class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4 md:space-y-0 md:flex md:items-center md:justify-between md:gap-4">
        <input type="hidden" name="SortBy" value="@filter.SortBy" />
        <input type="hidden" name="IsDescending" value="@filter.IsDescending.ToString().ToLower()" />
        <input type="hidden" name="PageNumber" id="pageNumberInput" value="@filter.PageNumber" />

        <div class="flex-1 grid grid-cols-1 md:grid-cols-3 gap-3">
            <!-- Search -->
            <div class="relative">
                <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" name="Search" value="@filter.Search" placeholder="Search name, email, subject..."
                       class="w-full pl-9 pr-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
            </div>

            <!-- Status Filter -->
            <div>
                <select name="IsRead" onchange="this.form.submit()"
                        class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="">All Statuses</option>
                    <option value="false" selected="@(filter.IsRead == false)">Unread Only</option>
                    <option value="true" selected="@(filter.IsRead == true)">Read Only</option>
                </select>
            </div>

            <!-- Page Size -->
            <div>
                <select name="PageSize" onchange="this.form.submit()"
                        class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    <option value="5" selected="@(filter.PageSize == 5)">5 per page</option>
                    <option value="10" selected="@(filter.PageSize == 10)">10 per page</option>
                    <option value="25" selected="@(filter.PageSize == 25)">25 per page</option>
                </select>
            </div>
        </div>

        <button type="submit" class="w-full md:w-auto px-5 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-xl text-xs font-semibold transition-all">
            Apply Filters
        </button>
    </form>

    <!-- Table -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 font-semibold">
                        <th class="px-6 py-4 cursor-pointer sortable-col" data-sort="IsRead">
                            Status <i class="bi bi-arrow-down-up ml-1 text-[10px]"></i>
                        </th>
                        <th class="px-6 py-4 cursor-pointer sortable-col" data-sort="SenderName">
                            Sender <i class="bi bi-arrow-down-up ml-1 text-[10px]"></i>
                        </th>
                        <th class="px-6 py-4 cursor-pointer sortable-col" data-sort="Subject">
                            Subject <i class="bi bi-arrow-down-up ml-1 text-[10px]"></i>
                        </th>
                        <th class="px-6 py-4 cursor-pointer sortable-col" data-sort="CreatedAt">
                            Date <i class="bi bi-arrow-down-up ml-1 text-[10px]"></i>
                        </th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-sm text-slate-700 dark:text-slate-300">
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-slate-500">
                                <i class="bi bi-inbox text-3xl mb-2 block"></i>
                                No messages found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/30 transition-colors @(!item.IsRead ? "font-bold bg-blue-50/20 dark:bg-blue-950/10" : "")">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <button type="button" onclick="toggleReadStatus('@item.Id')"
                                            class="px-2.5 py-1 rounded-full text-[10px] font-semibold transition-all @(item.IsRead ? "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400" : "bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300")">
                                        @(item.IsRead ? "Read" : "Unread")
                                    </button>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-slate-900 dark:text-white">@item.SenderName</div>
                                    <div class="text-xs text-slate-500 font-mono">@item.SenderEmail</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="truncate max-w-xs text-slate-800 dark:text-slate-200">@item.Subject</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-xs text-slate-500">
                                    @item.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right space-x-1">
                                    <button type="button" onclick="viewMessageDetails('@item.Id')"
                                            class="p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
                                        <i class="bi bi-eye text-xs"></i>
                                    </button>
                                    <button type="button" onclick="openDeleteModal('@item.Id')"
                                            class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                                        <i class="bi bi-trash text-xs"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="px-6 py-4 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <span class="text-xs text-slate-500">
                    Showing page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong> (@Model.TotalCount total)
                </span>
                <div class="flex items-center gap-1">
                    <button type="button" onclick="goToPage(@(Model.PageNumber - 1))"
                            disabled="@(!Model.HasPreviousPage)"
                            class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs font-medium disabled:opacity-40 disabled:cursor-not-allowed">
                        Previous
                    </button>
                    <button type="button" onclick="goToPage(@(Model.PageNumber + 1))"
                            disabled="@(!Model.HasNextPage)"
                            class="px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-xs font-medium disabled:opacity-40 disabled:cursor-not-allowed">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Details Modal -->
<div id="detailsModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
    <div id="detailsContainer" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl w-full max-w-lg overflow-hidden transform scale-95 transition-transform duration-200">
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <h3 class="text-md font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i class="bi bi-envelope-open text-blue-600"></i> Message Details
            </h3>
            <button type="button" onclick="closeDetailsModal()" class="text-slate-400 hover:text-slate-600">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="p-6 space-y-4">
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase">From:</span>
                <div id="msgSender" class="text-sm font-bold text-slate-900 dark:text-white"></div>
                <div id="msgEmail" class="text-xs text-blue-600 font-mono"></div>
            </div>
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase">Subject:</span>
                <div id="msgSubject" class="text-sm font-semibold text-slate-800 dark:text-slate-200"></div>
            </div>
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase">Message:</span>
                <div id="msgContent" class="mt-1 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 text-xs text-slate-700 dark:text-slate-300 leading-relaxed whitespace-pre-wrap"></div>
            </div>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 flex justify-end">
            <button type="button" onclick="closeDetailsModal()" class="px-4 py-2 text-xs font-medium bg-slate-200 dark:bg-slate-800 rounded-xl">Close</button>
        </div>
    </div>
</div>

<!-- Anti-Forgery Form Token -->
<form id="csrfForm" class="hidden">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script src="../Views//Message/Index.cshtml.js" asp-append-version="true"></script>
}