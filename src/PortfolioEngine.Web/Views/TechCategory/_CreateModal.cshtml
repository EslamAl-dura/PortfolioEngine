@using PortfolioEngine.Domain.Common
@using PortfolioEngine.Domain.Enums
@model CreateTechCategoryViewModel

<div id="createCategoryModal"
     class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">

    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl w-full max-w-lg overflow-hidden transform scale-95 transition-transform duration-200" id="modalContainer">

        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i class="bi bi-folder-plus text-blue-600"></i> Create Technology Category
            </h3>
            <button type="button" onclick="closeModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1 rounded-lg">
                <i class="bi bi-x-lg text-lg"></i>
            </button>
        </div>

        <!-- Modal Form -->
        <form id="createCategoryForm" asp-action="Create" method="post" class="p-6 space-y-4">
            @Html.AntiForgeryToken()

            <!-- Validation Summary -->
            <div id="validationSummary" class="hidden p-3 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 rounded-lg text-xs text-red-600 dark:text-red-400"></div>

            <!-- Name -->
            <div>
                <label asp-for="Name" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Category Name</label>
                <input asp-for="Name" placeholder="e.g. Frontend Frameworks"
                       class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white dark:focus:bg-slate-900 transition-all" />
                <span asp-validation-for="Name" class="text-xs text-red-500"></span>
            </div>

            <!-- Type Enum Dropdown -->
            <div>
                <label asp-for="Type" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Category Type</label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<CategoryTypes>()"
                        class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all">
                    <option value="">-- Select Type --</option>
                </select>
                <span asp-validation-for="Type" class="text-xs text-red-500"></span>
            </div>

            <!-- Icon Class -->
            <div>
                <label asp-for="IconClass" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Icon Class (Bootstrap/FontAwesome)</label>
                <input asp-for="IconClass" placeholder="e.g. bi bi-layers"
                       class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                <span asp-validation-for="IconClass" class="text-xs text-red-500"></span>
            </div>

            <!-- Description -->
            <div>
                <label asp-for="Description" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Description</label>
                <textarea asp-for="Description" rows="3" placeholder="Brief summary of this tech category..."
                          class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-500"></span>
            </div>

            <!-- Actions -->
            <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-100 dark:border-slate-800">
                <button type="button" onclick="closeModal()"
                        class="px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors">
                    Cancel
                </button>
                <button type="submit"
                        class="px-5 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 active:bg-blue-800 rounded-xl shadow-sm transition-all flex items-center gap-2">
                    <i class="bi bi-check-lg"></i> Save Category
                </button>
            </div>
        </form>
    </div>
</div>