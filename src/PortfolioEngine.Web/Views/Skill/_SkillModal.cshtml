@using PortfolioEngine.Domain.Configs

<div id="skillModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200">
    <div id="skillModalContainer" class="modal-scrollbar bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl w-full max-w-lg max-h-full flex flex-col transform scale-95 transition-transform duration-200 overflow-hidden">

        <!-- Header -->
        <div class="px-6 py-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between shrink-0">
            <h3 id="skillModalTitle" class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i id="skillModalIcon" class="bi bi-award text-blue-600"></i>
                <span id="skillModalTitleText">Add Skill</span>
            </h3>
            <button type="button" onclick="closeSkillModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg">
                <i class="bi bi-x-lg text-lg"></i>
            </button>
        </div>

        <!-- Form Wrapper -->
        <form id="skillForm" method="post" class="flex flex-col min-h-0 flex-1">
            @Html.AntiForgeryToken()

            <!-- Hidden field for Skill ID -->
            <input type="hidden" id="skill_Id" name="Id" value="" />

            <!-- Scrollable Body -->
            <div class="p-6 space-y-4 overflow-y-auto flex-1 custom-scrollbar">

                <!-- Validation Summary -->
                <div id="skillValidationSummary" class="hidden p-3 bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 rounded-lg text-xs text-red-600 dark:text-red-400"></div>

                <!-- Name -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Name</label>
                    <input id="skill_Name" name="Name" required placeholder="e.g. C# Development, UI/UX Design"
                           class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
                </div>

                <!-- Soft Skill Checkbox -->
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="skill_IsSoftSkill" name="IsSoftSkill" value="true"
                           class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 dark:border-slate-700 dark:bg-slate-800" />
                    <input type="hidden" name="IsSoftSkill" value="false" />
                    <label for="skill_IsSoftSkill" class="text-sm font-medium text-slate-700 dark:text-slate-300 cursor-pointer">
                        This is a Soft Skill (non-technical)
                    </label>
                </div>

                <!-- Proficiency Slider -->
                <div>
                    <div class="flex justify-between items-center mb-1">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">Proficiency Level</label>
                        <span id="proficiencyValue" class="text-xs font-bold text-blue-600 dark:text-blue-400">80%</span>
                    </div>
                    <input type="range" id="skill_Proficiency" name="Proficiency" min="0" max="100" value="80"
                           oninput="$('#proficiencyValue').text(this.value + '%')"
                           class="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-600" />
                </div>

                <!-- Icon Picker Grid -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">Select Icon</label>
                        <span class="text-xs font-medium text-blue-600 dark:text-blue-400 flex items-center gap-1.5">
                            <i id="selectedIconPreview" class="bi bi-lightning-charge-fill text-sm"></i>
                            <span id="selectedIconName">lightning-charge-fill</span>
                        </span>
                    </div>

                    <!-- Hidden Input for IconClass -->
                    <input type="hidden" id="skill_IconClass" name="IconClass" value="lightning-charge-fill" />

                    <!-- Search Input -->
                    <div class="relative mb-2">
                        <i class="bi bi-search absolute left-3 top-2.5 text-xs text-slate-400"></i>
                        <input type="text" id="iconSearchInput" placeholder="Search icons..."
                               class="w-full pl-8 pr-3 py-1.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-xs text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
                    </div>

                    <!-- 5-Column Grid -->
                    <div class="h-40 overflow-y-auto p-2 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-slate-200 dark:border-slate-700/80 custom-scrollbar">
                        <div class="grid grid-cols-5 gap-2" id="iconGrid">
                            @foreach (var icon in IconConfig.AllowedIcons)
                            {
                                <button type="button"
                                        data-icon-key="@icon.Key"
                                        data-icon-label="@icon.Label"
                                        title="@icon.Label (@icon.Key)"
                                        class="icon-option-btn group flex flex-col items-center justify-center p-2.5 rounded-xl border border-slate-200/60 dark:border-slate-700/50 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-blue-500 dark:hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 hover:shadow-sm transition-all">
                                    <i class="bi bi-@icon.Key text-xl transition-transform group-hover:scale-110"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <!-- Technologies Multi-Select with Checkboxes -->
                <div class="relative space-y-1.5" id="tech-select-container">
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Technologies <span class="text-rose-500">*</span>
                    </label>

                    <!-- Dropdown Trigger Button -->
                    <button type="button"
                            id="tech-dropdown-btn"
                            class="flex w-full items-center justify-between rounded-xl border border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900/60 px-3.5 py-2.5 text-left text-sm text-slate-900 dark:text-slate-100 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-colors">
                        <span id="tech-selected-text" class="truncate text-slate-400 dark:text-slate-500">
                            Select technologies...
                        </span>
                        <i class="bi bi-chevron-down text-xs text-slate-400 transition-transform duration-200" id="tech-dropdown-arrow"></i>
                    </button>

                    <!-- Hidden native select element to hold values for ASP.NET model binding / form submit -->
                    <select id="SelectedTechnologyIds" name="SelectedTechnologyIds" multiple class="hidden">
                        @if (ViewBag.Technologies != null)
                        {
                            foreach (var tech in (IEnumerable<SelectListItem>)ViewBag.Technologies)
                            {
                                <option value="@tech.Value">@tech.Text</option>
                            }
                        }
                    </select>

                    <!-- Multi-Select Popover Menu -->
                    <div id="tech-dropdown-menu"
                         class="absolute left-0 right-0 z-50 mt-1 hidden max-h-60 overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-2 shadow-xl ring-1 ring-black/5 transition-all">

                        <!-- Search Input Filter -->
                        <div class="relative mb-2">
                            <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-xs text-slate-400"></i>
                            <input type="text"
                                   id="tech-search-input"
                                   placeholder="Search technologies..."
                                   class="w-full rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 py-1.5 pl-8 pr-3 text-xs text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" />
                        </div>

                        <!-- Checkbox Options List -->
                        <div class="max-h-40 overflow-y-auto space-y-1 pr-1 custom-scrollbar" id="tech-options-list">
                            @if (ViewBag.Technologies != null)
                            {
                                foreach (var tech in (IEnumerable<SelectListItem>)ViewBag.Technologies)
                                {
                                    <label class="tech-option-item flex cursor-pointer items-center justify-between rounded-lg px-2.5 py-1.5 text-sm text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/70 transition-colors">
                                        <div class="flex items-center gap-2.5 truncate">
                                            <input type="checkbox"
                                                   value="@tech.Value"
                                                   data-label="@tech.Text"
                                                   class="tech-checkbox h-4 w-4 rounded border-slate-300 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-slate-900" />
                                            <span class="truncate font-medium">@tech.Text</span>
                                        </div>
                                    </label>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Description</label>
                    <textarea id="skill_Description" name="Description" rows="2" placeholder="Optional notes or summary..."
                              class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500"></textarea>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="px-6 py-4 flex items-center justify-end gap-3 border-t border-slate-100 dark:border-slate-800 shrink-0 bg-white dark:bg-slate-900">
                <button type="button" onclick="closeSkillModal()" class="px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl">Cancel</button>
                <button type="submit" id="skillSubmitBtn" class="px-5 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-sm">Save Skill</button>
            </div>
        </form>
    </div>
</div>